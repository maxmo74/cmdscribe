# Rendered by install.sh; @CS_LOG_USER@ and @CS_LOG_GROUP@ are substituted.
#
# Neither value can be hardcoded, and getting them wrong fails quietly:
#
#   - logrotate refuses to rotate a file in a directory that is writable by a
#     group other than the one it is creating the file for. Ubuntu's /var/log is
#     0775 root:adm, so `create 0600 root root` is rejected outright -- logrotate
#     errors every week and the log NEVER rotates, growing without bound while
#     holding typed passwords. Debian's /var/log is 0755 and hides this.
#   - the created file must be writable by the account rsyslog runs as, which is
#     root on Debian and syslog on Ubuntu. A root:root 0600 file is unwritable by
#     an unprivileged rsyslog, so logging stops at the first rotation.
#
# Mode stays 0600. Without `create` at all, logrotate recreates this
# world-readable and hands every command typed on the box to any local user.
/var/log/cmdscribe.log {
    weekly
    rotate 12
    create 0600 @CS_LOG_USER@ @CS_LOG_GROUP@
    missingok
    notifempty
    compress
    delaycompress

    postrotate
        # rsyslog keeps writing to the rotated inode until something tells it to
        # reopen. Nothing else fixes it. Measured on Ubuntu 24.04: without this
        # stanza the post-rotation record landed in cmdscribe.log.1, rsyslog's fd
        # stayed pinned to that inode, and the live log held zero records forever
        # -- the host looks instrumented and records nothing. rsyslog does poll
        # for rotation, but relying on a poll interval to notice that an auditing
        # tool has stopped auditing is not a design, it is a coincidence.
        if [ -x /usr/lib/rsyslog/rsyslog-rotate ]; then
            /usr/lib/rsyslog/rsyslog-rotate
        elif command -v systemctl >/dev/null 2>&1; then
            systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
        elif [ -r /run/rsyslogd.pid ]; then
            kill -HUP "$(cat /run/rsyslogd.pid)" >/dev/null 2>&1 || true
        elif [ -r /var/run/rsyslogd.pid ]; then
            kill -HUP "$(cat /var/run/rsyslogd.pid)" >/dev/null 2>&1 || true
        fi
    endscript
}
